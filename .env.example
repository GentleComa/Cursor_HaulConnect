# HaulConnect Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

FLASK_ENV=development
FLASK_DEBUG=1

# SECRET_KEY: Generate a strong random key for production
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# DATABASE_URL: SQLite database path (defaults to instance/haulconnect.db)
DATABASE_URL=sqlite:///instance/haulconnect.db
